# =====================================================================
# LLM 投資策略與自動追蹤系統 — 環境變數範本
# 複製為 .env 後填入實際值：cp .env.example .env
# 此檔不含任何真實金鑰，是唯一會進入 Git 倉儲的 .env 系列檔案。
# =====================================================================

# --- 應用服務 --------------------------------------------------------
APP_NAME=Investment Assistant
# development | production；production 會強制要求下方安全性變數齊備
APP_ENV=development
HOST=0.0.0.0
PORT=8080
DEBUG=false

# --- 資料庫後端 ------------------------------------------------------
# json = 本機直接讀寫 data/assets.json；firestore = GCP 雲端
# 注意：部署至 Cloud Run 時必須為 firestore，容器檔案系統不具持久性
DB_BACKEND=json
JSON_DATA_PATH=data/assets.json

# --- GCP Firestore（DB_BACKEND=firestore 時必填）---------------------
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_CONFIG=system_config
FIRESTORE_COLLECTION_PORTFOLIO=portfolio

# --- Google Gemini ---------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini 輸出成本控制（output 單價為 input 的 8.3 倍，是主要成本來源）
# 上限需留餘裕：結構化輸出被截斷會導致 JSON 反序列化失敗而整筆作廢
BUY_ANALYSIS_MAX_OUTPUT_TOKENS=800
MARKET_REPORT_MAX_OUTPUT_TOKENS=1024
# 留空 = 沿用模型預設（gemini-3.5-flash-lite 的 thinking 預設為 Off）
# 若改用 thinking 預設開啟的模型，設為 MINIMAL 可避免費用暴增
GEMINI_THINKING_LEVEL=

# --- LINE Messaging API ----------------------------------------------
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
# 排程推播的目標使用者 ID
LINE_USER_ID=
# 授權白名單（JSON 陣列）。此檢查為 fail-closed：留空則所有人都被拒絕
ALLOWED_LINE_USER_IDS=[]

# --- 安全性 ----------------------------------------------------------
# /api/* 管理端點的存取金鑰，production 必填
ADMIN_API_KEY=your_admin_api_key_here
CORS_ALLOWED_ORIGINS=[]

# --- 外部 API 逾時與重試 ---------------------------------------------
HTTP_TIMEOUT_SECONDS=15.0
MAX_RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY=1.0
RETRY_BACKOFF_FACTOR=2.0

# --- 買入策略 --------------------------------------------------------
BUY_CANDIDATES=["2330", "6442", "2313", "2454", "2382", "SPCX"]
USD_TWD_RATE=32.0

# 掃描並行度：刻意保守，避免觸發 Gemini / yfinance 的 rate limit (429)
BUY_SCAN_CONCURRENCY=3
# 新聞快取存活秒數（0 = 停用）
NEWS_CACHE_TTL_SECONDS=3600
# 新聞關鍵字預篩：off | shadow | enforce
# 預設 shadow（只記錄判定不淘汰）。改為 enforce 前必須先量測 recall，
# 漏掉一檔真利多的代價遠高於省下的一次 Gemini 呼叫
NEWS_FILTER_MODE=shadow

# --- 背景排程 --------------------------------------------------------
ENABLE_SCHEDULER=true
SELL_CHECK_INTERVAL_MINUTES=30
BUY_CHECK_CRON_HOUR=13
BUY_CHECK_CRON_MINUTE=0
MARKET_REPORT_CRON_HOUR=8
MARKET_REPORT_CRON_MINUTE=0
MARKET_REPORT_CRON_DAYS=mon-sun

# --- SLM（選用的自然語言 fallback）----------------------------------
# 確定性規則解析（app/services/nlu_rules.py）永遠優先且無需設定。
# 此處僅供規則層無法辨識時的降級推論，端點應指向本機 Ollama 或相容伺服器。
# 依 SLM_PLAN v2：不得指向 Colab tunnel，Colab 僅限離線訓練。
SLM_ENABLED=false
SLM_ENDPOINT_URL=http://localhost:8000/v1
SLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
SLM_API_KEY=EMPTY
SLM_TIMEOUT_SECONDS=5.0
SLM_FALLBACK_TO_REGEX=true

# --- Hugging Face（僅離線訓練階段需要）------------------------------
# read scope 足以下載 base model；上傳微調權重需 write scope。
# 注意：Colab 為遠端執行階段，讀不到本機 .env，需在 Colab 端設環境變數。
HUGGINGFACE_API_KEY=
